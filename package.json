{
  "name": "jackgracie-sveltekit",
  "version": "1.0.0",
  "private": true,
  "description": "Jack Gracie Portfolio - SvelteKit SPA",
  "author": "jcgithu",
  "keywords": [
    "svelte",
    "sveltekit",
    "portfolio",
    "spa"
  ],
  "scripts": {
    "dev": "bun run vite dev",
    "build": "bun run vite build",
    "preview": "bun run vite preview",
    "sync:redirects": "bun scripts/sync-redirects.js",
    "check": "bun run sync:redirects && bun run svelte-kit sync && bun run svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run sync:redirects && bun run svelte-kit sync && bun run svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/animejs": "^4.0.0",
    "mdsvex": "^0.12.8",
    "sass": "^1.105.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@rive-app/webgl2": "^2.44.0",
    "@sveltejs/enhanced-img": "^0.8.5",
    "animejs": "^4.5.0",
    "lottie-web": "^5.13.0",
    "poline": "^0.13.1",
    "runed": "^0.37.1",
    "zod": "^4.6.5"
  },
  "type": "module"
}
